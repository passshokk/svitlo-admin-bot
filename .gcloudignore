# Локальне віртуальне середовище
venv/
env/

# Локальні змінні середовища
.env

# Захист сервісних ключів (блокуємо тільки потенційні ключі Google/Firebase)
*.json

# Кеш Python та налаштування редактора
__pycache__/
.vscode/
webhook_setup.py
db_migration.py

# Системні файли Git та конфіги
.git/
.gitignore
.gcloudignore
.claude

# Скрипти автоматизації Windows (не потрібні в хмарі)
*.cmd
*.ps1

# Ручні адмінські скрипти: міграції, аудити, розсилки, звірки.
# У git вони лишаються — без них не відтворити історію рішень і не запустити
# перевірки на свіжому клоні. Але в контейнер їхати не мають: у проді їх ніхто
# не викликає, зате вони тягнуть зайві залежності й розширюють поверхню атаки.
#
# Тримати цей запис саме тут, а не покладатись на .gitignore: коли .gcloudignore
# існує, gcloud читає ТІЛЬКИ його і на .gitignore не дивиться взагалі. Через це
# scripts/ і продовжував їхати в хмару, хоч і був у .gitignore.
scripts/