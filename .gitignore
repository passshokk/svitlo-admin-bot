# Секрети
.env
*.json

# Віртуальне середовище (це гігабайти зайвих файлів)
venv/
env/

# Кеш Python та налаштування VS Code
__pycache__/
.vscode/
webhook_setup.
db_migration.py
.claude

# Локальні скрипти автоматизації Windows, які не потрібні в хмарі
*.cmd
*.ps1

# Ручні адмінські скрипти лишаються в репозиторії: у fix_data_quality.py живе
# журнал ручних рішень по чистці даних, у README — порядок міграції, а решта
# потрібна для повторних аудитів і звірок. Ключі вони беруть зі змінних
# середовища, захардкоджених секретів не містять.
#
# З деплою вони виключені окремо — через scripts/ у .gcloudignore.